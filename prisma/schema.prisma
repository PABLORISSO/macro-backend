generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Series {
  id          Int         @id @default(autoincrement())
  code        String      @unique
  name        String
  category    String
  unit        String?
  frequency   String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  dataPoints  DataPoint[]

  @@map("series")
}

model DataPoint {
  id         BigInt   @id @default(autoincrement())
  seriesCode String
  date       DateTime @db.Date
  value      Float
  metadata   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  series Series @relation(fields: [seriesCode], references: [code], onDelete: Cascade)

  @@unique([seriesCode, date])
  @@index([seriesCode, date])
  @@map("data_points")
}
